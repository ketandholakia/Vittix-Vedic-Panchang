{
    "name": "vittix/panchang",
    "description": "Dependency-free Hindu Panchang calculation engine written in pure PHP. No FFI, no C libraries, no external binaries.",
    "keywords": ["panchang", "hindu", "tithi", "nakshatra", "yoga", "karana", "vara", "vedic", "calendar", "astronomy"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Vittix\\Panchang\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vittix\\Panchang\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "analyse": "phpstan analyse src tests --level=8",
        "quality": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
