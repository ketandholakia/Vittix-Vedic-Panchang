{
    "name": "vittix/panchang",
    "description": "Vittix Vedic Panchang & Astrology Engine for PHP. Accurate Panchang, Kundli, and astrology calculations without native extensions.",
    "keywords": [
        "vedic",
        "panchang",
        "hindu",
        "calendar",
        "astrology",
        "kundli",
        "horoscope",
        "jyotish",
        "laravel",
        "php"
    ],
    "homepage": "https://github.com/ketandholakia/Vittix-Vedic-Panchang",
    "support": {
        "issues": "https://github.com/ketandholakia/Vittix-Vedic-Panchang/issues",
        "source": "https://github.com/ketandholakia/Vittix-Vedic-Panchang",
        "docs": "https://hindutithi.in/"
    },
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Vittix Panchang Dev",
            "email": "dev@vittix.local",
            "homepage": "https://github.com/ketandholakia",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Vittix\\Panchang\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vittix\\Panchang\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "analyse": "phpstan analyse src tests --level=8",
        "quality": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
